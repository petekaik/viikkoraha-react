# ⚠️ Copy this file to .env and fill in real values.
# .env is gitignored — NEVER commit it.
#
# Vite loads .env automatically during build (npm run build / npm run dev).
# For GitHub Actions CI, set these as repository secrets:
#   Settings → Secrets and variables → Actions → New repository secret
#   Names: VITE_GOOGLE_CLIENT_ID, VITE_GOOGLE_API_KEY

# Google OAuth 2.0 Client ID — Web application type
# Authorised JavaScript origins: https://your-domain.com (or localhost for dev)
VITE_GOOGLE_CLIENT_ID=

# Google API Key — Sheets API + Drive API enabled
# Recommended: restrict to HTTP referrers (your domain) and APIs (Sheets, Drive)
VITE_GOOGLE_API_KEY=

# Optional: pre-fill spreadsheet ID (empty = user picks in-app)
# VITE_SPREADSHEET_ID=

# Deployed app URL (for smoke tests)
DEPLOY_URL=https://gitpages.morgeweb.com/viikkoraha
