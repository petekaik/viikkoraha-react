# ⚠️ Copy this file to .env and fill in real values
# .env is gitignored — NEVER commit it

# Google OAuth 2.0 Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=

# Google API Key (Sheets API enabled)
VITE_GOOGLE_API_KEY=

# Google Sheets Spreadsheet ID (for testing)
VITE_SPREADSHEET_ID=

# Deployed app URL (for smoke tests)
DEPLOY_URL=https://gitpages.morgeweb.com/viikkoraha
