# ══════════════════════════════════════════════════════════
# Viikkoraha E2E-testien ympäristömuuttujat
# ══════════════════════════════════════════════════════════
#
# KOPIOI:  cp .env.e2e.example .env.e2e
# TÄYTÄ:  alla olevat arvot
#
# .env.e2e on gitignored — älä committaa oikeita arvoja.

# ── Google OAuth 2.0 access token ───────────────────────
# Ohjeet tokenin generointiin: docs/TESTING.md
E2E_ACCESS_TOKEN=

# ── Tokenin expiry Unix-timestamp (0 = ei tarkistusta) ──
E2E_TOKEN_EXPIRY=0

# ── Käyttäjätiedot (näkyvät Headerissa) ─────────────────
E2E_USER_NAME=Test User
E2E_USER_EMAIL=test@example.com

# ── Google Sheets Spreadsheet ID ─────────────────────────
E2E_SPREADSHEET_ID=

# ── iOS-laite ────────────────────────────────────────────
# 'auto' = safaridriver valitsee ainoan yhdistetyn laitteen
# Muussa tapauksessa: UDID (löytyy: system_profiler SPUSBDataType)
E2E_DEVICE_UDID=auto

# ── Deploy-URL ──────────────────────────────────────────
E2E_DEPLOY_URL=https://gitpages.morgeweb.com/viikkoraha
